# Ключ OpenRouter (https://openrouter.ai/keys). Не коммитить настоящий .env!
OPENROUTER_API_KEY=
# Модель: алиас последней DeepSeek V4 Flash; для фиксированной версии укажите, например, deepseek/deepseek-v4-flash
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
# Адрес MCP-сервера (streamable HTTP)
MCP_URL=http://127.0.0.1:8000/mcp
# Необязательно: общий секрет между API и MCP-сервером
MCP_AUTH_TOKEN=
